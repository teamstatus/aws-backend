{
  "name": "@teamstatus/aws-backend",
  "version": "0.0.0-development",
  "description": "AWS backend for teamstatus developed using CDK in TypeScript",
  "type": "module",
  "scripts": {
    "test": "node --no-warnings --experimental-transform-types --test \"!(node_modules)/**/*.spec.ts\"",
    "prepare": "husky && check-node-version --package",
    "cdk:lambda:update": "node --no-warnings --experimental-transform-types ./cdk/cli/update-lambdas.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teamstatus/aws-backend.git"
  },
  "bugs": {
    "url": "https://github.com/teamstatus/aws-backend/issues"
  },
  "homepage": "https://github.com/teamstatus/aws-backend#readme",
  "keywords": [
    "teamstatus",
    "backend",
    "aws",
    "cdk"
  ],
  "author": "Markus Tacker <m@coderbyheart.com> | coderbyheart.com",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.982.0",
    "@aws-sdk/client-dynamodb": "3.982.0",
    "@aws-sdk/client-iam": "3.982.0",
    "@aws-sdk/client-lambda": "3.982.0",
    "@aws-sdk/client-s3": "3.982.0",
    "@aws-sdk/client-ses": "3.982.0",
    "@aws-sdk/client-sns": "3.982.0",
    "@aws-sdk/client-ssm": "3.982.0",
    "@aws-sdk/s3-request-presigner": "3.982.0",
    "@aws-sdk/util-dynamodb": "3.982.0",
    "@bifravst/aws-cdk-lambda-helpers": "3.5.139",
    "@bifravst/ci": "2.1.1",
    "@biomejs/biome": "2.4.6",
    "@commitlint/config-conventional": "20.4.3",
    "@nordicsemiconductor/cloudformation-helpers": "9.1.0",
    "@sinclair/typebox": "0.34.48",
    "@swc/cli": "0.8.0",
    "@swc/core": "1.15.18",
    "@types/aws-lambda": "8.10.161",
    "@types/chance": "1.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.9.1",
    "aws-cdk": "2.1110.0",
    "aws-cdk-lib": "2.241.0",
    "cdk": "2.1110.0",
    "chalk": "5.6.2",
    "chance": "1.1.13",
    "check-node-version": "4.2.1",
    "commitlint": "20.4.3",
    "constructs": "10.5.1",
    "husky": "9.1.7",
    "lint-staged": "16.3.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "ulid": "3.0.2"
  },
  "lint-staged": {
    "*.{md,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "npx biome format --write",
      "npx biome check"
    ]
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=9"
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failTitle": false
        }
      ]
    ]
  },
  "dependencies": {
    "@bifravst/from-env": "3.0.2",
    "@middy/core": "6.4.5",
    "@middy/input-output-logger": "6.4.5",
    "jsonwebtoken": "9.0.3",
    "mailparser": "3.9.4"
  }
}
